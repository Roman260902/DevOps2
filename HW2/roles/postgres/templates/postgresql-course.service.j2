{{ ansible_managed | comment }}

[Unit]
Description=Course PostgreSQL cluster
After=network.target

[Service]
Type=simple
User=postgres
Group=postgres
RuntimeDirectory=postgresql
RuntimeDirectoryMode=2775
ExecStart={{ __pg_bin_dir }}/postgres -D {{ postgres__data_dir }}
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGINT
TimeoutStopSec=0
Restart=on-failure

[Install]
WantedBy=multi-user.target
