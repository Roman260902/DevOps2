FROM python:3.11.6-slim-bookworm AS build

SHELL ["/bin/sh", "-eu", "-c"]

WORKDIR /build

RUN python -m pip install --no-cache-dir \
    "poetry==1.8.5" \
    "poetry-plugin-export==1.8.0" \
    setuptools wheel

COPY pyproject.toml poetry.lock README.md ./
COPY src/ ./src/

RUN mkdir -p dist \
    && poetry export \
        --without-hashes \
        --format constraints.txt \
        --output dist/constraints.txt \
    && poetry run python -m pip wheel \
        --isolated \
        --requirement dist/constraints.txt \
        --wheel-dir dist/vendor \
    && poetry build --format wheel


FROM python:3.11.6-slim-bookworm AS final

SHELL ["/bin/sh", "-eu", "-c"]

ARG APP_USER=appuser
ARG APP_UID=1001
ARG APP_GID=1001
ARG APP_HOME=/app

RUN addgroup --gid "${APP_GID}" "${APP_USER}" \
    && adduser --disabled-password --gecos "" \
        --home "${APP_HOME}" \
        --ingroup "${APP_USER}" \
        --uid "${APP_UID}" \
        "${APP_USER}"

COPY --from=build /build/dist/ /dist/

RUN python -m pip install \
    --isolated \
    --no-index \
    --no-cache-dir \
    --no-deps \
    /dist/*.whl /dist/vendor/*.whl

WORKDIR ${APP_HOME}
USER ${APP_USER}

ENV HOST=0.0.0.0
ENV PORT=8080

EXPOSE 8080

CMD ["python", "-m", "counter_backend"]
